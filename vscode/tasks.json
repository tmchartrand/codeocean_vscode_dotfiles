{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "chezmoi background sync",
            "type": "shell",
            "command": "( while true; do chezmoi re-add; chezmoi git push; sleep 60; done )",
            "isBackground": true,
            "hide": true,
            "runOptions": {
                "runOn": "folderOpen"
            },
            "options": {
                "env": {"GIT_ASKPASS": "echo ${env:GIT_ACCESS_TOKEN}"}
            },
            "presentation": {
                "panel": "new",
                "reveal": "never"
            }
        }
    ]
}